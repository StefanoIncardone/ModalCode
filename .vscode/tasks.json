{
  "version":"2.0.0",
  "tasks":[
    {"type":"npm", "script":"compile-main",       "group":"build", "problemMatcher":["$tsc"]},
    {"type":"npm", "script":"compile-dev",        "group":"build", "problemMatcher":["$tsc"]},
    {"type":"npm", "script":"compile-main-watch", "group":"build", "problemMatcher":["$tsc"]},
    {"type":"npm", "script":"compile-dev-watch",  "group":"build", "problemMatcher":["$tsc"]},

    {"type":"npm", "script":"check",      "problemMatcher":["$tsc"]},
    {"type":"npm", "script":"check-lint", "problemMatcher":["$tsc", "$eslint-stylish"]},
    {"type":"npm", "script":"lint",       "problemMatcher":["$eslint-stylish"]},
  ]
}
