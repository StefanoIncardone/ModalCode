{
  "name": "modalcode",
  "displayName": "ModalCode",
  "version": "0.1.3",
  "author": {
    "name": "Stefano Incardone",
    "email": "stefanoincardone@gmail.com"
  },
  "description": "Adding user-defined modes to VsCode",
  "homepage": "https://github.com/StefanoIncardone/ModalCode#README.md",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/StefanoIncardone/ModalCode"
  },

  "categories": ["Keymaps", "Other"],
  "keywords": ["modes"],
  "activationEvents": ["*"],

  "contributes": {
    "configuration": [
      {
        "title": "General",
        "properties": {
          "modalcode.settingsChangeAction": {
            "title": "Settings change action",
            "description": "Action to take when settings change",

            "type": "string",
            "default": "automatic reload",
            "enum": [
              "automatic reload",
              "ask to reload",
              "no action"
            ],
            "enumDescriptions": [
              "Automatically reload without asking",
              "Show a notification asking if modes should be reloaded",
              "Do not reload nor ask for a reload"
            ]
          }
        }
      },
      {
        "title": "Editor Modes",
        "properties": {
          "modalcode.modes": {
            "title": "Modes",
            "description": "List of editor modes",

            "type": "array",
            "uniqueItems": true,
            "items": {
              "description": "Mode properties",

              "type": "object",
              "required": ["name", "capturing"],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "description": "The name of the mode",
                  "minLength": 1,
                  "maxLength": 16
                },
                "capturing": {
                  "type": "boolean",
                  "description": "Whether the mode should capture typing events",
                  "default": false
                },
                "description": {
                  "type": "string",
                  "description": "Mode description",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    ],

    "commands": [
      {
        "category": "ModalCode",
        "title": "Select mode",
        "command": "modalcode.select"
      },
      {
        "category": "ModalCode",
        "title": "Reload modes",
        "command": "modalcode.reload"
      }
    ]
  },

  "type": "module",
  "main": "./out/main/extension.js",
  "scripts": {
    "tsc":      "tsc",
    "tsc-main": "tsc -p ./tsconfig-main.json",
    "tsc-dev":  "tsc -p ./tsconfig-dev.json",

    "compile-main":       "npm run tsc-main",
    "compile-dev":        "npm run tsc-dev",
    "compile-main-watch": "npm run compile-main -- -- --watch",
    "compile-dev-watch":  "npm run compile-dev -- -- --watch",

    "check":      "npm run tsc-main -- --noEmit",
    "check-lint": "npm run check && npm run lint",
    "lint":       "eslint ."
  },

  "engineStrict": false,
  "engines": {
    "vscode": "^1.135.0"
  },
  "peerDependencies": {
    "jiti": "2.7.0"
  },
  "devDependencies": {
    "@types/vscode": "1.134.0",
    "typescript": "6.0.3",

    "eslint": "10.9.1",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.68.0",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "globals": "17.11.0"
  }
}
